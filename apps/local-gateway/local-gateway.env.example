# Copy to %ProgramData%\AliaSpaces\local-gateway.env (install script does this) and fill in.
# Must equal the LOCAL_GATEWAY_TOKEN Supabase secret. Generate 48+ random chars; never commit.
LOCAL_GATEWAY_TOKEN=
# Loopback model server. LM Studio default shown; Ollama is http://127.0.0.1:11434/v1
GATEWAY_UPSTREAM=http://127.0.0.1:1234/v1
# Comma-separated model ids the hosted side may request. Must match local_fleet_personas.model.
GATEWAY_MODELS=gpt-oss:20b
GATEWAY_PORT=8787
GATEWAY_MAX_TOKENS=1024
GATEWAY_TIMEOUT_MS=90000
